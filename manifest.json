{
  "manifest_version": 3,
  "name": "CN Link Grabber Pro",
  "version": "4.1.0",
  "description": "Academic Resource Grabber, Batch PDF Downloader & In-Browser Video Trimming Studio in a refined Burgundy interface.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "downloads",
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CN Link Grabber Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "docs.html",
  "options_ui": {
    "page": "docs.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["m3-loading-indicator.js", "m3-wavy-progress.js", "content.js"],
      "css": ["style.css"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel/index.html",
        "docs.html",
        "docs.js",
        "m3-loading-indicator.js",
        "m3-wavy-progress.js",
        "assets/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
