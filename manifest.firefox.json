{
  "manifest_version": 3,
  "name": "CN Link Grabber Pro",
  "version": "4.1.0",
  "description": "Academic Resource Grabber, Batch PDF Downloader & In-Browser Video Trimming Studio in a refined Burgundy interface.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CN Link Grabber Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "sidebar_action": {
    "default_panel": "sidepanel/index.html",
    "default_title": "CN Link Grabber Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "docs.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["m3-loading-indicator.js", "m3-wavy-progress.js", "content.js"],
      "css": ["style.css"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel/index.html",
        "docs.html",
        "docs.js",
        "m3-loading-indicator.js",
        "m3-wavy-progress.js",
        "assets/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cn-link-grabber-pro@marjukamin.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
